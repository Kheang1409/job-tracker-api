# MongoDB
CONNECTION_STRINGS=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=JobTrackerDb
JOB_APPLICATION_MONGODB_DATABASE_NAME=JobTrackerApplicationsDb

# JWT
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=JobTracker
JWT_EXPIRY_MINUTES=60
# Optional separate secret (32+ characters); JWT_SECRET_KEY is used when omitted.
OUTBOX_ENCRYPTION_KEY=<generate-a-separate-long-random-secret>

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=<sender-email>
SMTP_SENDER_PASSWORD=<smtp-app-password>

# Kafka
KAFKA_BOOTSTRAP_SERVERS=<broker-host>:<port>
KAFKA_USERNAME=<kafka-username>
KAFKA_PASSWORD=<kafka-password>
KAFKA_EMAIL_TOPIC=email-notifications
KAFKA_SECURITY_PROTOCOL=SaslSsl
KAFKA_SASL_MECHANISM=Plain
# Docker mounts ./certs/ca.pem at this container path.
KAFKA_SSL_CA_LOCATION=/run/secrets/ca.pem
KAFKA_EMAIL_CONSUMER_GROUP=email-service
KAFKA_EMAIL_DLQ_TOPIC=email-notifications.dead-letter
EMAIL_MAX_DELIVERY_ATTEMPTS=5

FRONTEND_ORIGIN=http://localhost:4200
